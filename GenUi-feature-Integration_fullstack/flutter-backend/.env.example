# ============================================================
# Fberaucracy Backend — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fberaucracy
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=fberaucracy_db

# Constructed automatically from above — or override manually:
# DATABASE_URL=postgresql+asyncpg://fberaucracy:password@localhost:5432/fberaucracy_db

# --- OpenRouter AI ---
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_APP_TITLE=Sahil
# Optional app attribution in OpenRouter rankings
# OPENROUTER_SITE_URL=http://localhost:8000

# --- Google AI Embeddings (optional, only needed for RAG ingestion/search) ---
GOOGLE_API_KEY=

# Gemini Model to use
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# --- Firebase ---
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json

# OR paste the JSON content directly as an env var (for Docker/CI):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=fberaucracy_procedures

# --- RAG Settings ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
