# ============================================================
# GenUI - Environment Variables
# Copy this file to .env and fill in your OPENROUTER_API_KEY
# ============================================================

# -- Application ---------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=80
DEBUG=true
SECRET_KEY=change-me-in-production

# -- OpenRouter AI (the ONLY API key you need) ---------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_APP_TITLE=f-idarty

# -- Embeddings ----------------------------------------------------------------
# Handled locally by ChromaDB's built-in model (all-MiniLM-L6-v2)
# No external API key needed for embeddings!

# -- Firebase (authentication) ------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# -- ChromaDB ------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=fberaucracy_procedures

# -- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_ENABLED=true

# -- CORS ----------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
